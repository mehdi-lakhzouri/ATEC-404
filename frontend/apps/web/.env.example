# Copy to apps/web/.env.local (git-ignored). NEXT_PUBLIC_* values are inlined at build time.
# Ground station REST base (FastAPI, R5.5). Network control endpoints only answer local clients.
NEXT_PUBLIC_GROUND_API=http://127.0.0.1:8000
# Ground station WebSocket base; defaults to NEXT_PUBLIC_GROUND_API with ws:// when omitted.
NEXT_PUBLIC_GROUND_WS=ws://127.0.0.1:8000
