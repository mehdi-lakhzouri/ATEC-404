# Copy to ground_station/.env (git-ignored). Values override the defaults in artemis_ground/config.py.
# The MongoDB credentials are the ones of docker/.env (MONGO_ROOT_USERNAME / MONGO_ROOT_PASSWORD).
ARTEMIS_GROUND_MONGO_URI=mongodb://artemis_admin:change-me@127.0.0.1:27017/?authSource=admin
ARTEMIS_GROUND_MONGO_DB=artemis_mission
# Receiver: where the lunar link emulator delivers (udp 5790); ACKs go to the emulator's reverse port (R5.4)
ARTEMIS_GROUND_UDP_HOST=127.0.0.1
ARTEMIS_GROUND_UDP_PORT=5790
ARTEMIS_GROUND_ACK_TO=127.0.0.1:5794
# R5.3 emulator control port (local only)
ARTEMIS_GROUND_EMULATOR_CONTROL=127.0.0.1:5792
ARTEMIS_GROUND_NETWORK_CONTROL_ENABLED=true
# Future Next.js dashboard origins (JSON list)
ARTEMIS_GROUND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ARTEMIS_GROUND_LOG_LEVEL=INFO
ARTEMIS_GROUND_LOG_JSON=true
